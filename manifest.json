{
  "manifest_version": 3,
  "name": "Steam Monitor",
  "version": "1.0.0"
  "description": "Мониторинг цен Steam Market. Разработано: GFL25",

  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "scripting",
    "alarms"
  ],

  "host_permissions": [
    "https://steamcommunity.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }

}
